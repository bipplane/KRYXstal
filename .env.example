# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Model provider: "ark" (default) or "local-codex" for debugging with a Codex CLI
# that is already logged in on this machine (`codex login`). In local-codex mode
# the Ark variables are ignored, auth.json is linked from LOCAL_CODEX_HOME into
# every per-agent CODEX_HOME, and CODEX_MODEL optionally overrides the model.
MODEL_PROVIDER=ark
# LOCAL_CODEX_HOME=~/.codex
# CODEX_MODEL=

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default

# Agent identity API. Each Codex turn gets a short-lived AGENT_TOKEN and calls
# back to this URL from the IAM hook and the channel MCP server. Defaults:
# local-process -> http://127.0.0.1:PORT, docker -> http://host.docker.internal:PORT,
# podman -> http://host.containers.internal:PORT.
# AGENT_API_BASE_URL=http://127.0.0.1:3000
# Host path of runtime/ (MCP server + hook); defaults to the repo copy.
# RUNTIME_SCRIPTS_DIR=/app/runtime
# Display name for the human principal in channels.
USER_NAME=You
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# Runaway guards. Agent turns in one channel without a human message, and
# agent runs one human prompt may cause in total, before the server pauses.
# A ten-step countdown with N agents takes roughly 3N + 10 runs (24 with five).
CHATTER_BUDGET=32
TRACE_BUDGET=32
